local function createESP(player)
    if ESPCache[player] then return ESPCache[player] end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PL_ESP"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 150, 0, 40)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    billboard.Enabled = false
    billboard.MaxDistance = 500
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0
    label.Text = player.Name
    label.TextColor3 = (player.TeamColor and player.TeamColor.Color) or Color3.new(1,1,1)
    label.Parent = billboard
    ESPCache[player] = billboard
    return billboard
end

local function refreshESP(player)
    local bb = createESP(player)
    local char = player.Character
    if not char then bb.Enabled = false; return end
    local head = char:FindFirstChild("Head")
    if not head then
        task.spawn(function()
            local h = char:WaitForChild("Head", 5)
            if h and bb.Parent ~= h then bb.Parent = h end
            bb.Enabled = State.ESP
        end)
        return
    end
    if bb.Parent ~= head then bb.Parent = head end
    bb.Enabled = State.ESP
    local label = bb:FindFirstChild("Label")
    if label then
        label.Text = player.Name
        label.TextColor3 = (player.TeamColor and player.TeamColor.Color) or Color3.new(1,1,1)
    end
end

local function setupESPPlayer(player)
    if player == LocalPlayer then return end
    createESP(player)
    refreshESP(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5); refreshESP(player)
    end)
    player.Changed:Connect(function(prop)
        if prop == "Team" or prop == "TeamColor" then
            local bb = ESPCache[player]
            if bb then
                local label = bb:FindFirstChild("Label")
                if label then
                    label.TextColor3 = (player.TeamColor and player.TeamColor.Color) or Color3.new(1,1,1)
                end
            end
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do setupESPPlayer(p) end
Players.PlayerAdded:Connect(setupESPPlayer)

--// ============================================================
--// HITBOX — универсальный, для ВСЕХ игроков (кроме себя)
--// ============================================================
local function applyHitboxToCharacter(char)
    if not char then return end
    for partName, baseSize in pairs(HitboxParts) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local s = math.random(HITBOX_SCALE_MIN, HITBOX_SCALE_MAX) / 10
            part.Size         = Vector3.new(s, s, s)
            part.Transparency = 0.6
            part.Color        = Color3.fromRGB(255, 130, 180)
            part.Material     = Enum.Material.Neon
            part.CanCollide   = false
            part.Massless     = true
        end
    end
end

local function resetHitboxOnCharacter(char)
    if not char then return end
    for partName, baseSize in pairs(HitboxParts) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            part.Size         = baseSize
            part.Transparency = (partName == "HumanoidRootPart") and 1 or 0
            part.Color        = Color3.fromRGB(255, 255, 255)
            part.Material     = Enum.Material.Plastic
            part.CanCollide   = (partName == "HumanoidRootPart") and false or true
        end
    end
end

local function enableHitboxAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            applyHitboxToCharacter(p.Character)
        end
    end
end

local function disableHitboxAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            resetHitboxOnCharacter(p.Character)
        end
    end
end

--// ============================================================
--// MAIN LOOP
--// ============================================================
RunService.RenderStepped:Connect(function()
    local showFOV = State.Aim or State.Trigger or State.AimAssist
    if FOVCircle.Visible ~= showFOV then FOVCircle.Visible = showFOV end
    if showFOV then
        FOVCircle.Position = Camera.ViewportSize * 0.5
        FOVCircle.Radius   = State.FOV
    end

    -- HITBOX (для ВСЕХ игроков кроме себя)
    if State.Hitbox then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local char = p.Character
                if char then
                    for partName in pairs(HitboxParts) do
                        local part = char:FindFirstChild(partName)
                        if part and part:IsA("BasePart") then
                            local target = math.random(HITBOX_SCALE_MIN, HITBOX_SCALE_MAX) / 10
                            if math.abs(part.Size.X - target) > 0.1 then
                                part.Size         = Vector3.new(target, target, target)
                                part.Transparency = 0.6
                                part.Color        = Color3.fromRGB(255, 130, 180)
                                part.Material     = Enum.Material.Neon
                                part.CanCollide   = false
                                part.Massless     = true
                            end
                        end
                    end
                end
            end
        end
    end

    -- AIM / TRIGGER / AIMASSIST
    if State.Aim or State.Trigger or State.AimAssist then
        local target, part = findClosestEnemy()
        if target and part then
            if State.Aim then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, part.Position)
            end
            if State.Trigger then
                VirtualUser:Button1Down(Vector2.new(0, 0))
                VirtualUser:Button1Up(Vector2.new(0, 0))
            end
            if State.AimAssist then
                applyAimAssist(part)
            end
        end
    end

    if LastTeamName ~= (LocalPlayer.Team and LocalPlayer.Team.Name) then
        LastTeamName = LocalPlayer.Team and LocalPlayer.Team.Name
        updateTeamBadge()
    end
end)

--// ============================================================
--// TOGGLE BINDING
--// ============================================================
local function updateButtonVisual(key, indicator, label, badge, stroke, baseText)
    local on = State[key]
    if on then
        indicator.BackgroundColor3 = Theme.Green
        badge.BackgroundColor3 = Theme.GreenDark
        badge.TextColor3 = Theme.Text
        badge.Text = "ON"
        stroke.Color = Theme.Green
    else
        indicator.BackgroundColor3 = Theme.Accent
        badge.BackgroundColor3 = Color3.fromRGB(55, 30, 55)
        badge.TextColor3 = Theme.TextDim
        badge.Text = "OFF"
        stroke.Color = Theme.Stroke
    end
    label.Text = baseText
end

local function bindToggle(btn, key, text, indicator, label, badge, stroke)
    btn:SetAttribute("Key", key)
    btn.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        updateButtonVisual(key, indicator, label, badge, stroke, text)

        if not State[key] then
            if key == "Hitbox" then
                disableHitboxAll()
            elseif key == "ESP" then
                for _, bb in pairs(ESPCache) do
                    bb.Enabled = false
                end
            end
        elseif key == "Hitbox" then
            enableHitboxAll()
        elseif key == "ESP" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then refreshESP(p) end
            end
        end
    end)
end

bindToggle(ToggleTrigger, "Trigger",   "ТРИГГЕР",    TG_Ind,  TG_Lbl,  TG_Badge,  TG_Stroke)
bindToggle(ToggleAim,     "Aim",       "АИМБОТ",     AM_Ind,  AM_Lbl,  AM_Badge,  AM_Stroke)
bindToggle(ToggleAssist,  "AimAssist", "АИМ АССИСТ", AS_Ind,  AS_Lbl,  AS_Badge,  AS_Stroke)
bindToggle(ToggleHitbox,  "Hitbox",    "ХИТБОКС",    HB_Ind,  HB_Lbl,  HB_Badge,  HB_Stroke)
bindToggle(ToggleESP,     "ESP",       "ESP",        ESP_Ind, ESP_Lbl, ESP_Badge, ESP_Stroke)

