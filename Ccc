local function getTeamKind(player)
    local t = player.Team
    if not t then return "Neutral" end
    local n = t.Name
    if n == "Guards" or n == "Police" or n == "Wardens" then return "Guards" end
    if n == "Criminals" or n == "Escapees" or n == "Escaped" then return "Escapees" end
    if n == "Prisoners" or n == "Inmates" then return "Prisoners" end
    return "Neutral"
end

local function isFactionEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local my, his = getTeamKind(LocalPlayer), getTeamKind(player)
    if his == "Neutral" or my == "Neutral" then return false end
    if my == "Guards"    then return his == "Escapees" end
    if my == "Escapees"  then return his == "Guards"   end
    return false
end

local function isVisible(character)
    local head = character and character:FindFirstChild("Head")
    if not head then return false end
    local parts = Camera:GetPartsObscuringTarget({head.Position}, {LocalPlayer.Character, character})
    return #parts == 0
end

