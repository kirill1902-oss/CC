--// ============================================================
--// TARGET (aim/trigger — по-прежнему только враги по фракции)
--// ============================================================
local function findClosestEnemy()
    if not (State.Aim or State.Trigger or State.AimAssist) then return nil, nil end
    local now = os.clock()
    if now - lastTargetUpdate < TARGET_UPDATE_INTERVAL then
        return TargetCache.player, TargetCache.part
    end
    lastTargetUpdate = now

    local screenCenter = Camera.ViewportSize * 0.5
    local closest, closestDist, closestPart = nil, State.FOV, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if isFactionEnemy(p) then
            local char = p.Character
            local hrp  = CharacterCache[p]
            if char and hrp then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if dist < closestDist and isVisible(char) then
                            closest, closestDist, closestPart = p, dist, hrp
                        end
                    end
                end
            end
        end
    end
    TargetCache.player = closest
    TargetCache.part   = closestPart
    return closest, closestPart
end

local function applyAimAssist(targetPart)
    if not targetPart or not State.AimAssist then return end
    local camPos    = Camera.CFrame.Position
    local targetPos = targetPart.Position
    local lookDir   = Camera.CFrame.LookVector
    local toTarget  = (targetPos - camPos).Unit
    local angle     = math.deg(math.acos(math.clamp(lookDir:Dot(toTarget), -1, 1)))
    if angle > AimAssistConfig.MaxAngle then return end
    local desired = CFrame.lookAt(camPos, targetPos)
    Camera.CFrame = Camera.CFrame:Lerp(desired, AimAssistConfig.Smoothness)
end

